{
  "name": "resume-editor-workspace",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter front --filter resume-editor-backend dev",
    "dev:front": "pnpm --filter front dev",
    "dev:backend": "pnpm --filter resume-editor-backend dev",
    "build": "pnpm --filter front build",
    "test": "pnpm test:unit",
    "test:unit": "pnpm --filter front test && pnpm --filter resume-editor-backend test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
